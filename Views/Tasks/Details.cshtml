@{
}
@model CoreSkillsApp.Models.Task

@{
    ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>

<div>
    <h4>Task</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.TaskDescription</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Expected Closure</dt>
        <dd class="col-sm-10">@Model.ExpectedClosureDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Assigned To</dt>
        <dd class="col-sm-10">@Model.AssignedTo</dd>

        <dt class="col-sm-2">Completed</dt>
        <dd class="col-sm-10">@Model.CompletionStatus</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
